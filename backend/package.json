{
  "name": "medical-document-backend",
  "version": "1.0.0",
  "description": "Medical Document Management Backend with FHIR Standards",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node src/database/migrate.ts",
    "migrate:prod": "node dist/database/migrate.js",
    "migrate:export": "ts-node scripts/run-export-migration.ts",
    "migrate:admin": "ts-node scripts/run-admin-migration.ts",
    "migrate:integrations": "ts-node scripts/setup-integrations.ts",
    "setup:complete": "ts-node scripts/setup-complete-system.ts",
    "setup:security": "ts-node scripts/setup-security.ts",
    "setup:integrations": "ts-node scripts/setup-integrations.ts",
    "generate:certs": "openssl req -x509 -newkey rsa:4096 -keyout certs/server.key -out certs/server.crt -days 365 -nodes -subj '/CN=localhost'",
    "test": "jest",
    "test:document-processor": "ts-node test-document-processor.ts",
    "test:examples": "ts-node src/examples/document-processing-example.ts",
    "test:export": "jest tests/excelExport.test.ts",
    "test:cloud": "ts-node scripts/test-cloud-storage.ts",
    "test:integrations": "ts-node src/examples/integration-usage.ts",
    "backup:database": "ts-node scripts/backup-database.ts",
    "backup:full": "ts-node scripts/backup-full.ts",
    "setup": "npm run migrate && npm run test:document-processor",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "compromise": "^14.10.0",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-graphql": "^0.12.0",
    "express-rate-limit": "^7.1.5",
    "graphql": "^15.8.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^6.10.4",
    "nodemailer": "^6.9.7",
    "opencv4nodejs": "^5.6.0",
    "pdf2pic": "^3.0.4",
    "pg": "^8.11.3",
    "sharp": "^0.33.1",
    "swagger-ui-express": "^5.0.0",
    "tesseract.js": "^5.0.4",
    "winston": "^3.11.0",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.0",
    "@types/sharp": "^0.33.0",
    "@types/swagger-ui-express": "^4.1.6",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
